---
// Ft6 · Letter close. A signature and a colophon, nothing to navigate.
// Continues the closing band so the page ends on one colour.
import type { Strings } from '../i18n';

interface Props {
  t: Strings;
}

const { t } = Astro.props;
const year = new Date().getFullYear();
---

<footer class="sign">
  <div class="sign__inner wrap">
    <p class="sign__name">{t.sign.place}</p>
    <p class="sign__colophon">{t.sign.colophon} © {year}</p>
  </div>
</footer>

<style>
  .sign {
    color-scheme: dark;
    --color-muted: var(--color-band-muted);
    --color-rule: var(--palette-bright);
    background: var(--color-band);
    color: var(--color-ink);
  }

  .sign__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: var(--space-xs) var(--space-xl);
    padding-block: var(--space-lg) var(--space-xl);
    border-block-start: var(--rule-hair) solid var(--color-rule);
  }

  .sign__name {
    font-family: var(--font-display);
    font-weight: var(--name-weight);
    font-size: var(--text-md);
    letter-spacing: var(--name-tracking);
  }

  .sign__colophon {
    font-size: var(--text-sm);
    color: var(--color-muted);
  }
</style>
