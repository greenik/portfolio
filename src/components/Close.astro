---
// The page's one call to action: the address itself, set large on a deep-blue band,
// with a copy button for webmail users and a live clock for people in other time zones.
import { person } from '../data/projects';
import type { Strings } from '../i18n';

interface Props {
  t: Strings;
}

const { t } = Astro.props;
const copy = t.close.copy;
---

<section class="close" id="contact" aria-labelledby="close-title">
  <div class="close__inner wrap">
    <div class="close__head">
      <h2 id="close-title" class="section-title close__title">{t.close.title}</h2>
      <p class="close__availability">{t.close.availability}</p>
    </div>

    <div class="close__mail">
      <a class="close__address" href={`mailto:${person.email}`}>{person.email}</a>
      <button
        class="copy"
        type="button"
        hidden
        data-copy={person.email}
        data-done={copy.done}
        data-error={copy.error}
        data-status-done={copy.statusDone}
        data-status-error={copy.statusError}
      >
        <svg class="copy__check" viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
          <path d="M3 8.5 6.5 12 13 4.5" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"></path>
        </svg>
        <span class="copy__label">{copy.idle}</span>
      </button>
      <p class="visually-hidden" aria-live="polite" data-copy-status></p>
    </div>

    <p class="close__clock" data-clock={t.close.clock} data-locale={t.locale} data-zone={person.timeZone}>
      {t.close.clockFallback}
    </p>

    <ul class="close__links">
      <li>
        <a class="link" href={person.cv.href} download={person.cv.file}>{t.close.cv}</a>
        <span class="close__meta">{t.close.cvMeta}</span>
      </li>
      <li>
        <a class="link" href={person.linkedin} rel="me noopener">{t.close.linkedin}</a>
      </li>
    </ul>
  </div>
</section>

<script>
  // Copy the address; on failure, select it so a keyboard copy still works.
  const button = document.querySelector<HTMLButtonElement>('[data-copy]');
  const status = document.querySelector<HTMLElement>('[data-copy-status]');
  const address = document.querySelector<HTMLElement>('.close__address');

  if (button && status && address && navigator.clipboard) {
    const label = button.querySelector<HTMLElement>('.copy__label')!;
    const idle = label.textContent ?? '';
    let timer: number | undefined;

    const reset = () => {
      delete button.dataset.state;
      label.textContent = idle;
    };

    button.hidden = false;
    button.addEventListener('click', async () => {
      window.clearTimeout(timer);
      try {
        await navigator.clipboard.writeText(button.dataset.copy ?? '');
        button.dataset.state = 'copied';
        label.textContent = button.dataset.done ?? '';
        status.textContent = button.dataset.statusDone ?? '';
      } catch {
        const range = document.createRange();
        range.selectNodeContents(address);
        const selection = window.getSelection();
        selection?.removeAllRanges();
        selection?.addRange(range);
        button.dataset.state = 'error';
        label.textContent = button.dataset.error ?? '';
        status.textContent = button.dataset.statusError ?? '';
      }
      timer = window.setTimeout(reset, 2500);
    });
  }

  // Local time in Lublin, refreshed on the minute. Without JS the static fallback line stays.
  const clock = document.querySelector<HTMLElement>('[data-clock]');
  if (clock?.dataset.clock && clock.dataset.zone) {
    const template = clock.dataset.clock;
    const zone = clock.dataset.zone;
    const locale = clock.dataset.locale ?? 'en-GB';
    const time = new Intl.DateTimeFormat(locale, { timeZone: zone, hour: '2-digit', minute: '2-digit', hourCycle: 'h23' });
    const offset = new Intl.DateTimeFormat('en-GB', { timeZone: zone, timeZoneName: 'shortOffset' });

    const render = () => {
      const now = new Date();
      const gmt = offset.formatToParts(now).find((part) => part.type === 'timeZoneName')?.value ?? '';
      clock.textContent = template.replace('{time}', time.format(now)).replace('{offset}', gmt);
    };

    render();
    window.setTimeout(
      () => {
        render();
        window.setInterval(render, 60_000);
      },
      60_000 - (Date.now() % 60_000),
    );
  }
</script>

<style>
  /* A dark island in both themes: color-scheme: dark resolves every light-dark() token
     inside to its dark value, then the few that would sit too close to the deep blue are retuned. */
  .close {
    color-scheme: dark;
    --color-muted: var(--color-band-muted);
    --color-focus: var(--palette-light);
    --color-highlight: var(--palette-ink);
    --color-bright: var(--palette-light);
    background: var(--color-band);
    color: var(--color-ink);
  }

  .close__inner {
    display: grid;
    gap: var(--space-xl);
    padding-block: var(--space-3xl) var(--space-2xl);
  }

  .close__head {
    display: grid;
    gap: var(--space-sm);
  }

  .close__title {
    max-width: 22em;
  }

  .close__availability {
    color: var(--color-muted);
  }

  .close__mail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-md) var(--space-lg);
  }

  .close__address {
    font-family: var(--font-display);
    font-weight: var(--title-weight);
    font-size: var(--text-xl);
    line-height: 1.05;
    letter-spacing: var(--display-tracking);
    text-decoration-line: underline;
    text-decoration-color: var(--color-accent);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.12em;
    white-space: nowrap;
    transition: color var(--dur-micro) var(--ease-out);
  }

  .close__address:hover {
    color: var(--color-accent-text);
  }

  .close__address:active {
    color: var(--color-ink);
  }

  /* C1 · Outlined chip — all eight states. */
  .copy {
    display: inline-flex;
    align-items: center;
    gap: var(--space-xs);
    min-height: 44px;
    padding-inline: var(--space-md);
    border: var(--rule-hair) solid var(--color-muted);
    border-radius: var(--radius-sm);
    background: transparent;
    color: var(--color-ink);
    font: inherit;
    font-size: var(--text-sm);
    line-height: 1;
    white-space: nowrap;
    cursor: pointer;
    transition:
      background-color var(--dur-micro) var(--ease-out),
      transform var(--dur-micro) var(--ease-out);
  }

  .copy[hidden] {
    display: none;
  }

  .copy:hover {
    background: var(--palette-ink);
  }

  .copy:active {
    transform: translateY(1px);
  }

  .copy:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .copy[data-state='loading'] {
    cursor: progress;
  }

  .copy__check {
    display: none;
  }

  .copy[data-state='copied'] {
    border-color: var(--color-accent);
  }

  .copy[data-state='copied'] .copy__check {
    display: block;
    color: var(--color-accent-text);
  }

  .copy[data-state='error'] {
    border-color: var(--color-ink);
  }

  .close__clock {
    font-size: var(--text-sm);
    color: var(--color-muted);
    font-variant-numeric: tabular-nums;
  }

  .close__links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-sm) var(--space-xl);
  }

  .close__meta {
    margin-inline-start: var(--space-2xs);
    font-size: var(--text-sm);
    color: var(--color-muted);
    white-space: nowrap;
  }

  @media (min-width: 40rem) {
    .close__address {
      font-size: var(--text-display);
    }
  }

  @media (min-width: 60rem) {
    .close__inner {
      gap: var(--space-xl);
      padding-block: var(--space-4xl) var(--space-3xl);
    }
  }
</style>
